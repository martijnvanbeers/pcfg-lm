  doi = {10.18653/v1/2023.acl-short.6},
  url = {https://aclanthology.org/2023.acl-short.6},
  urldate = {2024-12-30},
  abstract = {Multiple algorithms are known for efficiently calculating the prefix probability of a string under a probabilistic context-free grammar (PCFG). Good algorithms for the problem have a runtime cubic in the length of the input string. However, some proposed algorithms are suboptimal with respect to the size of the grammar. This paper proposes a new speed-up of Jelinek and Lafferty's (1991) algorithm, which runs in O(n{\textasciicircum}3{\textbar}N{\textbar}{\textasciicircum}3 + {\textbar}N{\textbar}{\textasciicircum}4), where n is the input length and {\textbar}N{\textbar} is the number of non-terminals in the grammar. In contrast, our speed-up runs in O(n{\textasciicircum}2{\textbar}N{\textbar}{\textasciicircum}3 + n{\textasciicircum}3{\textbar}N{\textbar}{\textasciicircum}2).},
  file = {/home/martijn/Zotero/storage/WXDSPJCI/Nowak and Cotterell - 2023 - A Fast Algorithm for Computing Prefix Probabilities.pdf}
}

@mastersthesis{perdijk2024,
  title = {Assessing {{The Learnability}} of {{LLMs}}: {{Revealing Tree Structures}} in {{Transparent Transformers}}},
  author = {Perdijk, Sabijn},
  year = {2024},
  month = jun,
  address = {Amsterdam},
  abstract = {The urge to analyse the grammatical structure of language and the abilities of humans to incorporate this structure is practically as old as language itself. With the rise of artificial intelligence (AI) in the 1950s and, decades later, the rise of large language models (LLMs), this urge to analyse learning abilities expanded to the learning abilities of language models. In this thesis, we contribute to the research on learning abilities of language models by investigating the existence of a grammar learned by a language model. We train models on artificially generated data to make stronger claims about the acquired linguistic knowledge. To investigate a potentially learned grammar, we reconstruct constituency trees from the hidden representations of the models with two different methods: a probing approach and a parameter-free method called perturbed masking. Both methods showed that the language models have syntactical knowledge, but it was not possible to fully reconstruct constituency trees from their hidden representations. We suggest that this is either due to limitations of the interpretability methods or the fact that the model learns a grammar that deviates from the underlying grammar.},
  langid = {english},
  school = {Universiteit van Amsterdam},
  file = {/home/martijn/Zotero/storage/HZDKCVNJ/_.pdf}
}

@misc{qinSometimes2024,
  title = {Sometimes {{I}} Am a {{Tree}}: {{Data Drives Unstable Hierarchical Generalization}}},
  shorttitle = {Sometimes {{I}} Am a {{Tree}}},
  author = {Qin, Tian and Saphra, Naomi and {Alvarez-Melis}, David},
  year = {2024},
  month = dec,
  number = {arXiv:2412.04619},
  eprint = {2412.04619},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2412.04619},
  url = {http://arxiv.org/abs/2412.04619},
  urldate = {2024-12-23},
  abstract = {Language models (LMs), like other neural networks, often favor shortcut heuristics based on surface-level patterns. Although LMs behave like n-gram models early in training, they must eventually learn hierarchical syntactic representations to correctly apply grammatical rules out-of-distribution (OOD). In this work, we use case studies of English grammar to explore how complex, diverse training data drives models to generalize OOD. We construct a framework that unifies our understanding of random variation with training dynamics, rule selection with memorization, and data diversity with complexity. We show that these factors are nuanced, and that intermediate levels of diversity and complexity lead to inconsistent behavior across random seeds and to unstable training dynamics. Our findings emphasize the critical role of training data in shaping generalization patterns and illuminate how competing model strategies lead to inconsistent generalization outcomes across random seeds. Code is available at https://github.com/sunnytqin/concept\_comp.git.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computation and Language,Computer Science - Machine Learning},
  file = {/home/martijn/Zotero/storage/QTE8ASNC/Qin et al. - 2024 - Sometimes I am a Tree Data Drives Unstable Hierarchical Generalization.pdf;/home/martijn/Zotero/storage/HSYLRLWF/2412.html}
}

