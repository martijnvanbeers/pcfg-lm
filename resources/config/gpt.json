{
  "resource_path": "../../resources",
  "tokenizer": "../../resources/tokenizers/pcfg-tokenizer-hfbos_02",
  "dataset": "../../resources/datasets/0.2",
  "trainer": {
    "output_dir": "../../resources/checkpoints/hfhf/babygpt/matrix/0.2/bos/l8h8",
    "logging_dir": "../../resources/logs/hfhf/babygpt/matrix/0.2/bos/l8h8",
    "push_to_hub": false,
    "report_to": ["tensorboard"],
    "per_device_train_batch_size": 64,
    "per_device_eval_batch_size": 64,
    "evaluation_strategy": "steps",
    "eval_steps": 500,
    "logging_steps": 100,
    "save_steps": 1000,
    "gradient_accumulation_steps": 32,
    "eval_accumulation_steps": 16,
    "max_grad_norm": 0.5,
    "num_train_epochs": 5,
    "weight_decay": 0.1,
    "lr_scheduler_type": "cosine",
    "learning_rate": 0.001,
    "warmup_ratio": 0.1
  },
  "model": {
    "model_type": "gpt2",
    "activation_function": "gelu_new",
    "architectures": [
      "GPT2LMHeadModel"
    ],
    "attn_pdrop": 0.1,
    "bos_token_id": 0,
    "embd_pdrop": 0.1,
    "initializer_range": 0.02,
    "layer_norm_epsilon": 1e-05,
    "n_embd": 256,
    "n_head": 8,
    "n_layer": 8,
    "n_positions": 256,
    "resid_pdrop": 0.1,
    "summary_activation": null,
    "summary_first_dropout": 0.1,
    "summary_proj_to_labels": true,
    "summary_type": "cls_index",
    "summary_use_proj": true,
    "task_specific_params": {
      "text-generation": {
        "do_sample": true,
        "max_length": 50
      }
    }
  }
}
