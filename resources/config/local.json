{
  "resource_path": "../../resources",
  "tokenizer": "../../resources/tokenizers/pcfg-tokenizer-hfbos_02",
  "dataset": "../../resources/datasets/0.2",
  "trainer": {
    "push_to_hub": false,
    "report_to": ["tensorboard"],
    "output_dir": "../../resources/checkpoints/hfhf/xlstm/matrix/0.2/bos/b4e64",
    "logging_dir": "../../resources/logs/hfhf/xlstm/matrix/0.2/bos/b4e64",
    "per_device_train_batch_size": 64,
    "per_device_eval_batch_size": 64,
    "evaluation_strategy": "steps",
    "eval_steps": 500,
    "logging_steps": 100,
    "save_steps": 1000,
    "gradient_accumulation_steps": 32,
    "eval_accumulation_steps": 16,
    "max_grad_norm": 0.5,

    "num_train_epochs": 10,
    "weight_decay": 0.1,
    "lr_scheduler_type": "cosine",
    "learning_rate": 0.0005,
    "warmup_ratio": 0.1
  },
  "model": {
    "model_type": "xlstm",
    "num_blocks": 4,
    "embedding_dim": 64,
    "mlstm_block": {
      "mlstm": {
        "num_heads": 4
      }
    },
    "slstm_block": {
      "slstm": {
        "num_heads": 4
      }
    },
    "slstm_at": [
      1
    ],
    "context_length": 40
  }
}
